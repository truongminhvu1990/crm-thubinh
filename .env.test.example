# QA Playwright environment template.
# Copy to .env.test (gitignored) and fill in real values.
# Do NOT commit .env.test or real credentials.

# App under test
QA_BASE_URL=http://localhost:3000

# One Supabase auth account per role, used by tests/shared/utils/auth.ts.
# These must be real accounts seeded in the Dev/staging Supabase project —
# never point QA_BASE_URL or these credentials at production.
QA_OWNER_EMAIL=
QA_OWNER_PASSWORD=

QA_MANAGER_EMAIL=
QA_MANAGER_PASSWORD=

QA_SALES_EMAIL=
QA_SALES_PASSWORD=

QA_MARKETING_EMAIL=
QA_MARKETING_PASSWORD=

QA_VIEWER_EMAIL=
QA_VIEWER_PASSWORD=

# QA Wave 1 database-verification tests (tests/shared/utils/db.ts) do NOT
# read credentials from this file. They reuse SUPABASE_SERVICE_ROLE_KEY and
# NEXT_PUBLIC_SUPABASE_URL straight from your existing .env.local (see
# playwright.config.ts) so the service-role key isn't duplicated into a
# second file. Make sure .env.local points at the Dev project, not prod.
