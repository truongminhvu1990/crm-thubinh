# Supabase project URL and anon (public) key.
# Copy this file to .env.local and fill in real values — never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (Staff Identity & Authentication Foundation) - required
# server-side only for lib/supabase/admin.ts (Supabase Auth Admin:
# createUser/deleteUser when creating a staff member). Deliberately NOT
# NEXT_PUBLIC_-prefixed: this key bypasses Row Level Security entirely and
# must never reach the browser bundle. Get it from Supabase Dashboard ->
# Project Settings -> API -> service_role (use the Dev project's key here).
SUPABASE_SERVICE_ROLE_KEY=
